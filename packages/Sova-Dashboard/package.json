{
  "name": "sova-dashboard",
  "author": "saboooor",
  "version": "10.0.0",
  "homepage": "https://sova.fyi",
  "description": "Sova dashboard go brr",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saboooor/Sova.git"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "drizzle:check": "drizzle-kit check",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:up": "drizzle-kit up",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "postinstall": "drizzle-kit generate",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler dev",
    "start": "vite --open --mode ssr",
    "start.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --forcenode --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@anuragroy/tailwindcss-animate": "^1.0.6",
    "@eslint/js": "^10.0.1",
    "@libsql/client": "latest",
    "@luminescent/icons-qwik": "0.1.1",
    "@luminescent/ui": "^7.0.0",
    "@luminescent/ui-qwik": "7.0.0-2",
    "@qwik.dev/core": "2.0.0-beta.35",
    "@qwik.dev/router": "2.0.0-beta.35",
    "@sova/drizzle-schema": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@types/eslint": "9.6.1",
    "@types/node": "^25.9.1",
    "discord-api-types": "^0.38.48",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "10.4.1",
    "eslint-plugin-qwik": "2.0.0-beta.35",
    "globals": "^17.6.0",
    "lucide-icons-qwik": "1.16.0-qwik-v2",
    "prettier": "3.8.3",
    "simple-icons-qwik": "16.19.0-qwik-v2",
    "tailwindcss": "4.3.0",
    "ts-morph": "^28.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.0",
    "undici": "8.3.0",
    "vite": "7.3.3",
    "vite-tsconfig-paths": "6.1.1",
    "wrangler": "^4.95.0"
  }
}
